  align-items:center;
  justify-content:space-between;
  padding:0 4px;
}
.settingsTitle{
  font-size:22px;
  font-weight:900;
}
.settingsContent{
  flex:1;
  min-height:0;
  display:grid;
  grid-template-columns:270px 1fr 220px;
  gap:8px;
}
.listManager{
  padding:10px;
  display:flex;
  flex-direction:column;
  gap:8px;
}
.listCards{
  flex:1;
  overflow:auto;
  scrollbar-width:none;
}
.listCards::-webkit-scrollbar{display:none}
.manageCard{
  width:100%;
  min-height:66px;
  border-radius:16px;
  border:2px solid #d6e2ed;
  background:linear-gradient(145deg,#fff,#f6f9fd);
  margin-bottom:8px;
  padding:9px;
  text-align:left;
  box-shadow:0 3px 9px rgba(20,50,80,.08);
}
.manageCard.active{
  border-color:#2f80ed;
  box-shadow:0 0 0 3px rgba(47,128,237,.15),0 4px 12px rgba(20,50,80,.10);
}
.manageCard .name{
  font-size:18px;
  font-weight:900;
}
.manageCard .count{
  margin-top:4px;
  color:var(--muted);
  font-size:12px;
  font-weight:900;
}
.listActions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
}
.listDetail{
  padding:12px;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.detailHero{
  flex:1;
  min-height:0;
  border-radius:19px;
  border:1px solid var(--line2);
  background:
    radial-gradient(circle at 12% 10%,rgba(47,128,237,.12),transparent 32%),
    linear-gradient(145deg,#ffffff,#f6fafd);
  padding:18px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
}
.detailHero .listBigName{
  font-size:36px;
  font-weight:900;
}
.detailHero .listBigCount{
  color:var(--muted);
  font-size:17px;
  margin-top:6px;
  font-weight:900;
}
.detailHero .note{
  color:var(--muted);
  font-size:13px;
  margin-top:10px;
  max-width:320px;
  line-height:1.35;
}
.detailButtons{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.detailButtons button{
  height:42px;
  font-size:16px;
}
.hardwarePanel{
  padding:10px;
  display:flex;
  flex-direction:column;
  gap:8px;
}
.hardwareCard{
  border-radius:17px;
  border:1px solid var(--line2);
  background:#f7fbff;
  padding:10px;
}
.hardwareCard label{
  display:flex;
  justify-content:space-between;
  align-items:center;
  height:36px;
  font-size:14px;
  font-weight:900;
}
.hardwareCard button{
  width:100%;
  margin-top:7px;
}
.msg{
  margin-top:7px;
  font-size:12px;
  color:var(--muted);
  font-weight:800;
}

/* MODALS */
.modal{
  position:fixed;
  inset:0;
  display:none;
  align-items:center;
  justify-content:center;
  z-index:50;
  background:rgba(30,55,80,.26);
  backdrop-filter:blur(3px);
}
.modal.show{display:flex}
.modalBox{
  background:#fff;
  color:var(--text);
  border:1px solid #c3d5e4;
  border-radius:24px;
  box-shadow:0 20px 70px rgba(30,55,80,.28);
  overflow:hidden;
}
.modalHeader{
  height:46px;
  background:#f7fafc;
  border-bottom:1px solid #dbe6ef;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 12px;
}
.modalHeader h2{
  margin:0;
  font-size:19px;
}
.modalBody{padding:12px}
.selectListBox{width:560px;max-height:420px}
.listChoiceGrid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  max-height:340px;
  overflow:auto;
  scrollbar-width:none;
}
.listChoiceGrid::-webkit-scrollbar{display:none}
.choiceCard{
  min-height:84px;
  border-radius:18px;
  border:2px solid #d4e1ec;
  background:
    radial-gradient(circle at 12% 12%,rgba(47,128,237,.09),transparent 33%),
    linear-gradient(145deg,#ffffff,#f7fbff);
  padding:12px;
  text-align:left;
}
.choiceCard.active{
  border-color:#2f80ed;
  box-shadow:0 0 0 3px rgba(47,128,237,.15);
}
.choiceCard .name{font-size:20px;font-weight:900}
.choiceCard .count{font-size:13px;color:var(--muted);font-weight:900;margin-top:5px}
.choiceCard .miniNums{
  margin-top:8px;
  display:flex;
  gap:4px;
  flex-wrap:wrap;
  max-height:30px;
  overflow:hidden;
}
.miniDot{
  width:26px;
  height:24px;
  font-size:12px;
  border-radius:9px;
}

/* Number picker */
.numberPickerBox{width:620px;height:430px}
.numberPickerBody{
  height:384px;
  padding:12px;
  display:grid;
  grid-template-rows:auto 1fr auto;
  gap:10px;
}
.pickerInfo{
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.pickerListName{
  font-size:20px;
  font-weight:900;
}
.pickerCount{
  color:var(--muted);
  font-weight:900;
}
.pickerGrid{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  gap:8px;
  align-content:start;
}
.pickTile{
  height:50px;
  border-radius:16px;
  font-size:22px;
}
.pickTile.selected{
  border:4px solid var(--gold);
  box-shadow:0 0 0 3px rgba(255,204,51,.25),0 6px 15px rgba(255,204,51,.32), inset 0 1px 0 rgba(255,255,255,.35);
}
.pickerButtons{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:8px;
}
.pickerButtons button{
  height:39px;
  font-size:15px;
}

/* Match popup */
.popup{
  position:fixed;
  inset:0;
  display:none;
  align-items:center;
  justify-content:center;
  z-index:90;
  background:rgba(20,40,60,.32);
}
.popup.show{display:flex}
.popupBox{
  width:390px;
  border-radius:30px;
  background:#ffffff;
  border:5px solid #19b974;
  box-shadow:0 20px 75px rgba(25,185,116,.45);
  text-align:center;
  padding:24px;
}
.popupBox h2{
  margin:0;
  font-size:25px;
  color:#119957;
}
.popupNumber{
  font-size:105px;
  font-weight:900;
  line-height:1;
  margin:4px 0;
}
.popupText{
  font-size:18px;
  font-weight:900;
}
</style>
</head>
<body>
<header>
  <h1>Roulette Vision</h1>
  <div class="headerBtns">
    <button id="clearBtn" onclick="clearHistory()">Clear</button>
    <button id="settingsBtn" onclick="showSettings()">Settings</button>
    <button id="mainBtn" style="display:none" onclick="showMain()">Main</button>
  </div>
</header>

<section id="mainPage" class="page active">
  <div class="mainTop">
    <div class="panel controls">
      <div class="sectionTitle">Controls</div>

      <div class="toggleCard">
        <label>Camera</label>
        <input id="cameraToggle" class="switch" type="checkbox" checked onchange="toggleCamera()">
      </div>

      <div class="toggleCard">
        <label>Sound</label>
        <input id="soundToggle" class="switch" type="checkbox" onchange="toggleSound()">
      </div>

      <div class="toggleCard">
        <label>Arm</label>
        <input id="armToggle" class="switch" type="checkbox" onchange="toggleArm()">
      </div>

      <div class="smallStatus">
        <div class="k">Status</div>
        <div id="scanMini" class="v">STOP</div>
      </div>
    </div>

    <div class="panel scanArea">
      <div class="cameraShell">
        <img src="/stream.mjpg">
        <div id="badge" class="badge">READY</div>
      </div>
      <div class="scanButtons">
        <button class="green" onclick="startScan()">Start</button>
        <button class="red" onclick="stopScan()">Stop</button>
      </div>
    </div>

    <div class="panel infoArea">
      <div class="infoGrid">
        <div class="infoCard">
          <div class="k">Scan</div>
          <div id="scanBig" class="big">STOP</div>
        </div>
        <div class="infoCard">
          <div class="k">Last</div>
          <div id="lastNum" class="big">--</div>
        </div>
      </div>

      <div class="infoCard wide">
        <div class="k">Last Match</div>
        <div id="lastMatch" class="mid">--</div>
      </div>

      <div class="listSelectCard">
        <div class="listSelectTop">
          <div>
            <div id="mainListName" class="listName">List 1</div>
            <div id="mainListCount" class="listCount">0 numbers</div>
          </div>
          <button class="blue" onclick="openListSelector()">Select</button>
        </div>
        <div id="targetPreview" class="targetPreview"></div>
      </div>
    </div>
  </div>

  <div class="panel historyPanel">
    <div class="historyHead">
      <h2>History</h2>
      <div class="hint">Swipe numbers horizontally</div>
    </div>
    <div id="historyTrack" class="historyTrack"></div>
  </div>
</section>

<section id="settingsPage" class="page">
  <div class="settingsTop">
    <div class="settingsTitle">List Management</div>
    <div>
      <button class="green" onclick="saveLists()">Save Lists</button>
      <button onclick="showMain()">Back</button>
    </div>
  </div>

  <div class="settingsContent">
    <div class="panel listManager">
      <div class="sectionTitle">Lists</div>
      <div id="settingsListCards" class="listCards"></div>
      <div class="listActions">
        <button class="blue" onclick="addList()">Add</button>
        <button class="red" onclick="deleteEditingList()">Delete</button>
      </div>
    </div>

    <div class="panel listDetail">
      <div class="detailHero">
        <div id="detailName" class="listBigName">List 1</div>
        <div id="detailCount" class="listBigCount">0 numbers</div>
        <div class="note">Numbers are selected from a touch popup. No typing is needed on the 800×480 display.</div>
      </div>

      <div class="detailButtons">
        <button class="blue" onclick="openNumberPicker()">Fill Numbers</button>
        <button onclick="setEditingAsMain()">Use on Main</button>
        <button onclick="clearEditingNumbers()">Clear Numbers</button>
        <button class="green" onclick="saveLists()">Save List</button>
      </div>
    </div>

    <div class="panel hardwarePanel">
      <div class="sectionTitle">Hardware</div>

      <div class="hardwareCard">
        <label>Dry run <input id="dryRun" class="switch" type="checkbox"></label>
        <label>Sound <input id="buzzerEnabled" class="switch" type="checkbox"></label>
        <label>Arm <input id="actuatorEnabled" class="switch" type="checkbox"></label>
        <button class="green" onclick="saveHardware()">Save Hardware</button>
        <button onclick="testAction()">Test Action</button>
      </div>

      <div class="hardwareCard">
        <div class="hint">Default GPIO</div>
        <div class="hint">Buzzer: GPIO17</div>
        <div class="hint">Arm: GPIO18</div>
        <div id="msg" class="msg"></div>
      </div>
    </div>
  </div>
</section>

<div id="listSelectorModal" class="modal">
  <div class="modalBox selectListBox">
    <div class="modalHeader">
      <h2>Select active list</h2>
      <button onclick="closeListSelector()">Close</button>
    </div>
    <div class="modalBody">
      <div id="listChoiceGrid" class="listChoiceGrid"></div>
    </div>
  </div>
</div>

<div id="numberPickerModal" class="modal">
  <div class="modalBox numberPickerBox">
    <div class="modalHeader">
      <h2>Fill list</h2>
      <button onclick="closeNumberPicker()">Close</button>
    </div>
    <div class="numberPickerBody">
      <div class="pickerInfo">
        <div id="pickerListName" class="pickerListName">List</div>
        <div id="pickerCount" class="pickerCount">0 selected</div>
      </div>
      <div id="pickerGrid" class="pickerGrid"></div>
      <div class="pickerButtons">
        <button onclick="selectAllNumbers()">All</button>
        <button onclick="clearPickerNumbers()">Clear</button>
        <button class="green" onclick="savePickerAndClose()">Done</button>
      </div>
    </div>
  </div>
</div>

<div id="popup" class="popup">
  <div class="popupBox">
    <h2>TARGET FOUND</h2>
    <div id="popupNumber" class="popupNumber">--</div>
    <div class="popupText">Buzzer + Arm + Popup</div>
  </div>
</div>

<script>
let appSettings=null;
let editingListId=null;
let lastMatchId=null;

const RED=new Set([1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36]);

function colorClass(n){
  n=Number(n);
  if(n===0) return 'green';
  return RED.has(n)?'red':'black';
}

function numberTile(n, extra=''){
  return `<div class="rouletteTile ${colorClass(n)} ${extra}">${n}</div>`;
}

function historyTile(r){
  const t=(r.timestamp||'').split('T').pop().slice(0,8);
  return `<div class="rouletteTile ${colorClass(r.number)} historyTile ${r.isMatch?'match':''}">
    <div class="num">${r.number}</div>
    <div class="time">${t}</div>
    <div class="tag">${r.isMatch?'MATCH':''}</div>
  </div>`;
}

function selectedList(){
  if(!appSettings || !appSettings.lists || !appSettings.lists.length) return null;
  return appSettings.lists.find(x=>x.id===appSettings.selectedListId) || appSettings.lists[0];
}

function editingList(){
  if(!appSettings || !appSettings.lists || !appSettings.lists.length) return null;
  return appSettings.lists.find(x=>x.id===editingListId) || selectedList();
}

async function loadSettings(){
  appSettings=await (await fetch('/api/settings')).json();
  editingListId=appSettings.selectedListId;
  renderAll();
}

function renderAll(){
  renderMainList();
  renderListSelector();
  renderSettingsLists();
  renderSettingsDetail();
  renderHardware();
}

function renderMainList(){
  const l=selectedList();
  if(!l) return;

  document.getElementById('mainListName').textContent=l.name;
  document.getElementById('mainListCount').textContent=`${l.numbers.length} numbers`;
  document.getElementById('targetPreview').innerHTML=(l.numbers||[]).slice(0,18).map(n=>numberTile(n,'targetTile')).join('');
}

function renderListSelector(){
  const box=document.getElementById('listChoiceGrid');
  if(!box || !appSettings) return;

  box.innerHTML=(appSettings.lists||[]).map(l=>{
    const active=l.id===appSettings.selectedListId;
    const mini=(l.numbers||[]).slice(0,10).map(n=>numberTile(n,'miniDot')).join('');
    return `<button class="choiceCard ${active?'active':''}" onclick="selectMainList('${l.id}')">
      <div class="name">${l.name}</div>
      <div class="count">${l.numbers.length} numbers</div>
      <div class="miniNums">${mini}</div>
    </button>`;
  }).join('');
}

function renderSettingsLists(){
  const box=document.getElementById('settingsListCards');
  if(!box || !appSettings) return;

  box.innerHTML=(appSettings.lists||[]).map(l=>{
    const active=l.id===editingListId;
    return `<button class="manageCard ${active?'active':''}" onclick="editList('${l.id}')">
      <div class="name">${l.name}</div>
      <div class="count">${l.numbers.length} numbers</div>
    </button>`;
  }).join('');
}

function renderSettingsDetail(){
  const l=editingList();
  if(!l) return;

  editingListId=l.id;
  document.getElementById('detailName').textContent=l.name;
  document.getElementById('detailCount').textContent=`${l.numbers.length} numbers selected`;
}

function renderHardware(){
  const h=(appSettings&&appSettings.hardware)||{};

  document.getElementById('soundToggle').checked=!!h.buzzerEnabled;
  document.getElementById('armToggle').checked=!!h.actuatorEnabled;

  document.getElementById('dryRun').checked=!!h.dryRun;
  document.getElementById('buzzerEnabled').checked=!!h.buzzerEnabled;
  document.getElementById('actuatorEnabled').checked=!!h.actuatorEnabled;
}

function showMain(){
  document.getElementById('settingsPage').classList.remove('active');
  document.getElementById('mainPage').classList.add('active');
  document.getElementById('settingsBtn').style.display='';
  document.getElementById('mainBtn').style.display='none';
  document.getElementById('clearBtn').style.display='';
  renderAll();
}

function showSettings(){
  document.getElementById('mainPage').classList.remove('active');
  document.getElementById('settingsPage').classList.add('active');
  document.getElementById('settingsBtn').style.display='none';
  document.getElementById('mainBtn').style.display='';
  document.getElementById('clearBtn').style.display='none';
  editingListId=appSettings.selectedListId;
  renderAll();
}

function openListSelector(){
  renderListSelector();
  document.getElementById('listSelectorModal').classList.add('show');
}

function closeListSelector(){
  document.getElementById('listSelectorModal').classList.remove('show');
}

async function selectMainList(id){
  appSettings.selectedListId=id;
  await saveListsSilent();
  closeListSelector();
}

function editList(id){
  editingListId=id;
  renderSettingsLists();
  renderSettingsDetail();
}

async function addList(){
  const idx=(appSettings.lists||[]).length+1;
  const item={
    id:'list-'+Math.random().toString(16).slice(2,10),
    name:'List '+idx,
    numbers:[]
  };

  appSettings.lists.push(item);
  editingListId=item.id;
  appSettings.selectedListId=item.id;

  await saveListsSilent();
}

async function deleteEditingList(){
  if((appSettings.lists||[]).length<=1){
    document.getElementById('msg').textContent='At least one list is required.';
    return;
  }

  appSettings.lists=appSettings.lists.filter(x=>x.id!==editingListId);

  if(appSettings.selectedListId===editingListId){
    appSettings.selectedListId=appSettings.lists[0].id;
  }

  editingListId=appSettings.selectedListId;
  await saveListsSilent();
}

async function setEditingAsMain(){
  const l=editingList();
  if(!l) return;

  appSettings.selectedListId=l.id;
  await saveListsSilent();
  document.getElementById('msg').textContent='Selected as main list.';
}

function clearEditingNumbers(){
  const l=editingList();
  if(!l) return;

  l.numbers=[];
  renderSettingsDetail();
}

async function saveListsSilent(){
  appSettings=await (await fetch('/api/lists',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(appSettings)
  })).json();

  if(!editingListId) editingListId=appSettings.selectedListId;

  renderAll();
}

async function saveLists(){
  await saveListsSilent();
  document.getElementById('msg').textContent='Lists saved.';
}

function openNumberPicker(){
  renderNumberPicker();
  document.getElementById('numberPickerModal').classList.add('show');
}

function closeNumberPicker(){
  document.getElementById('numberPickerModal').classList.remove('show');
}

function renderNumberPicker(){
  const l=editingList();
  if(!l) return;

  const set=new Set((l.numbers||[]).map(Number));

  document.getElementById('pickerListName').textContent=l.name;
  document.getElementById('pickerCount').textContent=`${set.size} selected`;

  let html='';
  for(let n=0;n<=36;n++){
    html += `<button class="rouletteTile ${colorClass(n)} pickTile ${set.has(n)?'selected':''}" onclick="togglePickerNumber(${n})">${n}</button>`;
  }
  document.getElementById('pickerGrid').innerHTML=html;
}

function togglePickerNumber(n){
  const l=editingList();
  if(!l) return;

  const set=new Set((l.numbers||[]).map(Number));

  if(set.has(n)) set.delete(n);
  else set.add(n);

  l.numbers=[...set].sort((a,b)=>a-b);
  renderNumberPicker();
  renderSettingsDetail();
}

function selectAllNumbers(){
  const l=editingList();
  if(!l) return;

  l.numbers=Array.from({length:37},(_,i)=>i);
  renderNumberPicker();
  renderSettingsDetail();
}

function clearPickerNumbers(){
  const l=editingList();
  if(!l) return;

  l.numbers=[];
  renderNumberPicker();
  renderSettingsDetail();
}

async function savePickerAndClose(){
  await saveListsSilent();
  closeNumberPicker();
}

async function saveHardware(){
  const h={...(appSettings.hardware||{})};

  h.dryRun=document.getElementById('dryRun').checked;
  h.buzzerEnabled=document.getElementById('buzzerEnabled').checked;
  h.actuatorEnabled=document.getElementById('actuatorEnabled').checked;

  appSettings.hardware=await (await fetch('/api/hardware',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(h)
  })).json();

  renderHardware();
  document.getElementById('msg').textContent='Hardware saved.';
}

async function saveHardwarePartial(patch){
  const h={...(appSettings.hardware||{}),...patch};

  appSettings.hardware=await (await fetch('/api/hardware',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(h)
  })).json();

  renderHardware();
}

async function toggleSound(){
  await saveHardwarePartial({buzzerEnabled:document.getElementById('soundToggle').checked});
}

async function toggleArm(){
  await saveHardwarePartial({actuatorEnabled:document.getElementById('armToggle').checked});
}

async function toggleCamera(){
  await fetch('/api/camera',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({enabled:document.getElementById('cameraToggle').checked})
  });
}

async function startScan(){
  await fetch('/api/start',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({selectedListId:appSettings.selectedListId})
  });
}

async function stopScan(){
  await fetch('/api/stop',{method:'POST'});
}

async function clearHistory(){
  await fetch('/api/history/clear',{method:'POST'});
}

async function testAction(){
  await fetch('/api/test-action',{method:'POST'});
  document.getElementById('msg').textContent='Test action sent.';
}

function showMatchPopup(n,id){
  if(id===lastMatchId) return;

  lastMatchId=id;
  document.getElementById('popupNumber').textContent=n;

  const p=document.getElementById('popup');
  p.classList.add('show');

  setTimeout(()=>p.classList.remove('show'),2300);
}

async function poll(){
  try{
    const st=await (await fetch('/api/status')).json();

    document.getElementById('cameraToggle').checked=!!st.cameraEnabled;

    const scan=st.monitoring?'SCAN':'STOP';
    document.getElementById('scanMini').textContent=scan;
    document.getElementById('scanBig').textContent=scan;
    document.getElementById('badge').textContent=st.state||'READY';

    document.getElementById('lastNum').textContent=(st.history&&st.history.length)?st.history[0].number:'--';
    document.getElementById('lastMatch').textContent=st.latestMatch?st.latestMatch.number:'--';

    document.getElementById('historyTrack').innerHTML=(st.history||[]).slice(0,90).map(historyTile).join('');

    if(st.selectedList && appSettings && st.selectedList.id!==appSettings.selectedListId){
      appSettings.selectedListId=st.selectedList.id;
      renderMainList();
      renderListSelector();
    }

    if(st.latestMatch) showMatchPopup(st.latestMatch.number,st.latestMatch.id);
  }catch(e){}
}

loadSettings();
setInterval(poll,300);
poll();
</script>
</body>
</html>'''


class Handler(BaseHTTPRequestHandler):
    hub = None

    def log_message(self, fmt, *args):
        return

    def _json_body(self):
        length = int(self.headers.get("Content-Length", "0") or 0)
        if length <= 0:
            return {}
        return json.loads(self.rfile.read(length).decode("utf-8"))

    def send_json(self, data, status=200):
        body = json.dumps(data, indent=2, default=str).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = urlparse(self.path).path

        if path == "/":
            body = HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        elif path == "/api/settings":
            data = self.hub.store.get()
            data["hardwareStatus"] = self.hub.actions.status()
            self.send_json(data)

        elif path == "/api/status":
            self.send_json(self.hub.public_status())

        elif path == "/stream.mjpg":
            self.stream("frame")

        elif path == "/roi.mjpg":
            self.stream("roi")

        else:
            self.send_error(404)

    def do_POST(self):
        path = urlparse(self.path).path

        try:
            if path == "/api/lists":
                data = self.hub.store.update_lists(self._json_body())
                self.hub.selected_list = self.hub.store.selected_list()
                self.send_json(data)

            elif path == "/api/hardware":
                saved = self.hub.store.update_hardware(self._json_body())
                self.hub.actions.update_config(saved)
                self.send_json(saved)

            elif path == "/api/camera":
                body = self._json_body()
                self.send_json(self.hub.set_camera_enabled(bool(body.get("enabled", True))))

            elif path == "/api/start":
                body = self._json_body()
                self.send_json(self.hub.start_monitoring(body.get("selectedListId")))

            elif path == "/api/stop":
                self.send_json(self.hub.stop_monitoring())

            elif path == "/api/history/clear":
                self.send_json(self.hub.clear_history())

            elif path == "/api/test-action":
                self.send_json(self.hub.actions.trigger_async(number=None, list_name="manual", reason="manual_test"))

            else:
                self.send_error(404)

        except Exception as exc:
            self.send_json({"ok": False, "error": str(exc)}, status=500)

    def stream(self, mode):
        self.send_response(200)
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=frame")
        self.end_headers()

        while True:
            frame = self.hub.get_roi() if mode == "roi" else self.hub.get_frame()

            if frame is None:
                time.sleep(0.05)
                continue

            if mode == "roi":
                frame = cv2.resize(frame, None, fx=3, fy=3, interpolation=cv2.INTER_NEAREST)

            jpg = encode_jpeg(frame)

            if not jpg:
                continue

            try:
                self.wfile.write(b"--frame\r\n")
                self.wfile.write(b"Content-Type: image/jpeg\r\n")
                self.wfile.write(f"Content-Length: {len(jpg)}\r\n\r\n".encode("ascii"))
                self.wfile.write(jpg)
                self.wfile.write(b"\r\n")
                time.sleep(0.06)
            except Exception:
                break


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--config", default="data/config.json")
    parser.add_argument("--source", default=None)
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8080)
    args = parser.parse_args()

    cfg = load_config(args.config)
    ensure_project_dirs()

    cfg.setdefault("final_app", {
        "min_stable_frames": 2,
        "min_live_score": 0.70,
        "min_live_margin": 0.10,
        "min_confirm_score": 0.85,
        "min_confirm_margin": 0.20,
    })

    hub = FinalVisionHub(cfg, source=args.source)
    Handler.hub = hub
    hub.start()

    server = ThreadingHTTPServer((args.host, args.port), Handler)

    print(f"Roulette final app: http://192.168.1.251:{args.port}")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("Stopping...")
    finally:
        server.server_close()
        hub.close()


if __name__ == "__main__":
    main()
